APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI chat + optional embeddings
OPENAI_API_KEY=****
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama chat + local embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:0.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Choose ollama for local-first setup, or openai if you want OpenAI embeddings.
EMBEDDINGS_PROVIDER=ollama

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVER_K=4
SHORT_TERM_TURNS=6
GUARDRAIL_ENABLED=true

# Future agent/tool execution policies. These do not change the current fixed
# LangGraph chat flow.
AGENT_MAX_STEPS=3
AGENT_MAX_REPEAT_CALLS=1

# Existing six-case live answer test configuration
TEST_LLM_PROVIDER=ollama
TEST_LLM_MODEL=qwen2.5:0.5b

# Four-case evaluation record generation (application .venv)
EVAL_GENERATION_PROVIDER=ollama
EVAL_GENERATION_MODEL=qwen2.5:0.5b

# DeepEval/Ragas judge configuration (.venv-evals)
EVAL_JUDGE_MODEL=gpt-4o-mini
DEEPEVAL_METRIC_THRESHOLD=0.6
DEEPEVAL_TELEMETRY_OPT_OUT=YES
RAGAS_DO_NOT_TRACK=true

# Local/full evaluation gate policy
EVAL_REPORT_MAX_AGE_HOURS=24
EVAL_MIN_RAGAS_FAITHFULNESS=0.6
EVAL_MIN_RAGAS_CONTEXT_PRECISION=0.6
EVAL_MIN_PROMPTFOO_PASS_RATE=0.75
